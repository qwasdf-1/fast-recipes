{
  "schemaVersion": 1,
  "id": "fast_recipes",
  "version": "${version}",
  "name": "Fast Recipes",
  "description": "Opt-in server-side recipe optimizations for Minecraft.",
  "license": "Apache-2.0",
  "environment": "server",
  "entrypoints": {
    "server": ["dev.fastrecipes.FastRecipes"]
  },
  "mixins": ["fast_recipes.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "=${minecraft}",
    "java": ">=${java}"
  },
  "breaks": {
    "fastsuite": "*",
    "recipeessentials": "*"
  }
}
